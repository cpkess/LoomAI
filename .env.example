# Postgres connection (docker-compose default shown)
DATABASE_URL=postgres://loomai:loomai@localhost:5432/loomai

# Secret used for session signing and provider API key encryption.
# Generate with: openssl rand -base64 32
LOOMAI_SECRET=change-me-generate-a-real-secret

# Base URL of the app (used by Auth.js in production deployments)
# AUTH_URL=http://localhost:3000
